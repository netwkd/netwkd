#!/usr/bin/env python

"""The build entry the engine's own SCons runs."""

from pathlib import Path

Import("env")
Import("env_modules")

import SCons.Script

import sources

env_netwkd = env_modules.Clone()

sources.hold_determinism_floor(
    env_netwkd,
    lambda message: SCons.Script.Exit("netwkd: " + message),
    SCons.Script.ARGUMENTS,
)

if env["builtin_enet"]:
    env_netwkd.Prepend(CPPPATH=["#thirdparty/enet"])

if env["tests"]:
    env.Append(CPPDEFINES=[sources.TESTS])
    env_netwkd.Append(CPPDEFINES=[sources.TESTS])

if env["profiler"] == "tracy":
    env_netwkd.Append(CPPDEFINES=[sources.PROFILING])
    profiler_path = Path(env["profiler_path"])
    if (profiler_path / "public" / "TracyClient.cpp").is_file():
        profiler_path = profiler_path / "public"
    env_netwkd.Append(CPPPATH=[str(profiler_path.resolve())])

for path in sources.source_paths():
    env_netwkd.add_source_files(
        env.modules_sources,
        path.relative_to(sources.ROOT).as_posix(),
    )

env_switch = env_netwkd.Clone()
env_switch.Append(CCFLAGS=sources.SWITCH_ERROR_FLAGS[sources.dialect(env)])
for path in sources.SWITCH_SOURCES:
    env_switch.add_source_files(
        env.modules_sources,
        path.relative_to(sources.ROOT).as_posix(),
    )
