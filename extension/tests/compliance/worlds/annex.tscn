[gd_scene format=3]

[sub_resource type="GDScript" id="annex"]
script/source = "extends Node3D

const BUOY := \"res://extension/tests/compliance/worlds/buoy.tscn\"


func launch(called: String) -> void:
	var buoy: Node = load(BUOY).instantiate()
	buoy.name = called
	$Berth.add_child(buoy)
"

[node name="Annex" type="Node3D"]
script = SubResource("annex")

[node name="Berth" type="Node3D" parent="."]

[node name="Spawner" type="MultiplayerSpawner" parent="."]
_spawnable_scenes = PackedStringArray("res://extension/tests/compliance/worlds/buoy.tscn")
spawn_path = NodePath("../Berth")
