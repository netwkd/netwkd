[gd_scene format=3]

[sub_resource type="GDScript" id="buoy"]
script/source = "extends Node3D

var paint := \"\"
var label := \"\"
var turns := 0
var turns_heard := 0


func _ready() -> void:
	$BuoySync.synchronized.connect(_on_synchronized)


func _on_synchronized() -> void:
	turns_heard = turns


func turn() -> void:
	turns += 1
"

[sub_resource type="SceneReplicationConfig" id="buoy_sync"]
properties/0/path = NodePath(".:paint")
properties/0/spawn = true
properties/0/replication_mode = 0
properties/1/path = NodePath(".:turns")
properties/1/spawn = true
properties/1/replication_mode = 1

[node name="Buoy" type="Node3D"]
script = SubResource("buoy")

[node name="BuoySync" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("buoy_sync")
