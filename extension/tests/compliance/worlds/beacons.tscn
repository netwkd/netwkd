[gd_scene format=3]

[sub_resource type="GDScript" id="beacons"]
script/source = "extends Node3D


func turn() -> void:
	for counter: Node in [$Lamp, $Lamp/Bulb, $Mast, $Mast/Flag]:
		counter.turns += 1


func show_lamp_to(username: String) -> void:
	for player: NetwPlayer in Netw.session(self).players:
		if player.username == username:
			$Lamp/LampSync.set_visibility_for(player.peer_id, true)
			$Lamp/LampSync.update_visibility()
"

[sub_resource type="GDScript" id="counter"]
script/source = "extends Node3D

var turns := 0
"

[sub_resource type="SceneReplicationConfig" id="turns_sync"]
properties/0/path = NodePath(".:turns")
properties/0/spawn = true
properties/0/replication_mode = 1

[node name="Level" type="Node3D"]
script = SubResource("beacons")

[node name="Lamp" type="Node3D" parent="."]
script = SubResource("counter")

[node name="LampSync" type="MultiplayerSynchronizer" parent="Lamp"]
replication_config = SubResource("turns_sync")
public_visibility = false

[node name="Bulb" type="Node3D" parent="Lamp"]
script = SubResource("counter")

[node name="BulbSync" type="MultiplayerSynchronizer" parent="Lamp/Bulb"]
replication_config = SubResource("turns_sync")

[node name="Mast" type="Node3D" parent="."]
script = SubResource("counter")

[node name="MastSync" type="MultiplayerSynchronizer" parent="Mast"]
replication_config = SubResource("turns_sync")

[node name="Flag" type="Node3D" parent="Mast"]
script = SubResource("counter")

[node name="FlagSync" type="MultiplayerSynchronizer" parent="Mast/Flag"]
replication_config = SubResource("turns_sync")
public_visibility = false
