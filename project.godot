; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="networked"
config/tags=PackedStringArray("addon", "multiplayer", "networked")
run/main_scene="uid://3a3852p4fypv"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="uid://b8cn2fun55jsg"
config/icon="uid://cv7fmxmauvaxo"
config/macos_native_icon="res://assets/networked.icns"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/missing_await=2

[display]

window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/networked/plugin.cfg", "res://addons/networked_activity/plugin.cfg", "res://addons/networked_discord/plugin.cfg")

[gdunit4]

report/godot/push_error=true
hooks/session_hooks=Dictionary[String, bool]({
"res://addons/gdUnit4/src/core/hooks/GdUnitHtmlReporterTestSessionHook.gd": true,
"res://addons/gdUnit4/src/core/hooks/GdUnitXMLReporterTestSessionHook.gd": true,
"res://addons/networked_test/gdunit4/session_hook.gd": true
})
settings/test/test_lookup_folder="tests"

[network]

limits/debugger/max_chars_per_second=262144

[networked]

webrtc/turn_credentials_url="https://networked-turn.diejorarr.workers.dev/"
tests/nakama_host="127.0.0.1"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[steam]

initialization/initialize_on_startup=false
initialization/embed_callbacks=false
multiplayer_peer/max_channels=4
initialization/app_id=480
